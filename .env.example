# ══════════════════════════════════════════════════════════════════════════════
#  JARVIS configuration
#
#  The first-run setup wizard inside the JARVIS app writes this file for you.
#  You only need to edit it directly if you prefer to skip the wizard.
# ══════════════════════════════════════════════════════════════════════════════

# ── Brain (one of these is required) ──────────────────────────────────────────
# Anthropic gives the best quality. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-5

# Groq is free and fast. Get a key at console.groq.com (Google sign-in, no card).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Optional: Spotify (only needed for Spotify control) ───────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── User ──────────────────────────────────────────────────────────────────────
# Leave blank to use your macOS full name. Set USER_ADDRESS to override how
# JARVIS addresses you in spoken greetings (e.g. "Mr. Stark", "Captain", "Tony").
USER_NAME=
USER_ADDRESS=

# ── Voice ─────────────────────────────────────────────────────────────────────
TTS_VOICE=Daniel
TTS_RATE=175
WHISPER_MODEL=base

# ── Paths ─────────────────────────────────────────────────────────────────────
PROJECTS_DIR=~/Projects
